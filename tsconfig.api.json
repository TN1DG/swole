{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    // DOM for the web-standard Request/Response the function handlers use.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    // Vercel runs these as native ESM on Node, so relative imports carry
    // their .js extension, as nodenext enforces.
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // The Vercel functions (link previews for shared posts). Their own project
  // because they run on Node, unlike the app, and are bundled by Vercel, not
  // Vite.
  "include": ["api"]
}
