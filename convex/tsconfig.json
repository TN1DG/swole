{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings are required to use Convex.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,
    "strict": true,
    /* Matches tsconfig.app.json. The backend files are compiled by both
     * projects (the React layer imports them), so leaving it off here would
     * mean the same file was checked to two different standards.
     *
     * Tests are excluded below and checked by tsconfig.test.json without this
     * flag. The flag exists to stop an out-of-range read becoming a silent
     * `undefined` that travels; in a test an out-of-range read fails the test
     * immediately, which is the point of the test. Enabling it there produced
     * 155 errors whose only fix was 155 non-null assertions — pure noise, and
     * a habit worth not teaching. */
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    /* Allows process.env in auth.config.ts (env vars exist in the Convex runtime). */
    "types": ["node"],

    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["./_generated", "./**/*.test.ts", "./test.helpers.ts"]
}
